{
	"name": "@localman/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
		"build": "tsx scripts/build-api.ts",
		"start": "node dist/main.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"set-user-plan": "tsx --env-file-if-exists=../../.env scripts/set-user-plan.ts",
		"load:mock": "tsx scripts/load-mock.ts",
		"bench:mock-writes": "tsx scripts/bench-mock-writes.ts"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@localman/operations": "workspace:*",
		"@localman/shared": "workspace:*",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.1.0",
		"jose": "^6.2.12",
		"mongoose": "^9.3.3",
		"nanoid": "^5.1.16",
		"openid-client": "^6.8.8",
		"pino": "^9.6.0",
		"proxy-addr": "^2.0.8",
		"web-push": "^3.6.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/autocannon": "^7.12.7",
		"@types/express": "^5.0.6",
		"@types/oidc-provider": "^9.12.1",
		"@types/proxy-addr": "^2.0.3",
		"@types/supertest": "^6.0.3",
		"@types/web-push": "^3.6.4",
		"autocannon": "^8.0.0",
		"mongodb-memory-server": "^11.3.0",
		"oidc-provider": "^9.12.2",
		"supertest": "^7.1.0"
	}
}
