"import Foundation

var request = URLRequest(url: URL(string: "https://api.example.com/users?notify=true")!)
request.httpMethod = "POST"
request.addValue("Bearer abc123", forHTTPHeaderField: "Authorization")
request.addValue("application/json", forHTTPHeaderField: "Accept")
request.addValue("a", forHTTPHeaderField: "X-Tag")
request.addValue("b", forHTTPHeaderField: "X-Tag")
request.addValue("application/json", forHTTPHeaderField: "Content-Type")
request.httpBody = Data("{\\n  \\"name\\": \\"Ann\\",\\n  \\"age\\": 30\\n}".utf8)

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))"
`;

