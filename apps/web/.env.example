# Build-time settings for the web app (Vite inlines VITE_* at build time).
# Copy to .env.local to override; never put secrets here, they ship to the browser.

# Origin of the Localman API. Leave empty for same-origin requests (dev proxy
# in vite.config.ts, nginx in production). Set an absolute origin such as
# https://localman.hoandat.com only for a packaged desktop/mobile build.
VITE_API_BASE_URL=

# Origin of the identity provider; "Quản lý tài khoản" and "Liên kết Telegram"
# open <origin>/account. Use the local IdP (e.g. http://localhost:3000) in dev.
VITE_IDP_ORIGIN=https://auth.hoandat.com
