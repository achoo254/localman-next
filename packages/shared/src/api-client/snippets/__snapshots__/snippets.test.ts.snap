request.httpBody = Data("it's \\"quoted\\" | $HOME \${x} $(id) \`id\` | back\\\\slash \\\\n \\\\u0041 \\\\$ | line1\\nline2 | tab\\there | #{x} #$x #@x | @/etc/passwd | Tiếng Việt 🚀 中文 | ‘smart’ “double” ‚low‛".utf8)

let (data, _) = try await URLSession.shared.data(for: request)
