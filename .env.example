# Localman API (apps/api). Copy to .env for local development.
NODE_ENV=development

# Dashboard API (localman.hoandat.com) and public mock runtime ({secret}.localman.hoandat.com)
DASHBOARD_PORT=4000
MOCK_PORT=4100

# MongoDB single-node replica set from docker-compose.yml
MONGO_URI=mongodb://localhost:27017/localman?replicaSet=rs0&directConnection=true

# Origin allowed to call the dashboard API (Vite dev server)
WEB_ORIGIN=http://localhost:5173

# Public origin of the dashboard: OIDC redirect URIs (${PUBLIC_URL}/auth/callback)
# and the CSRF origin check. Over https the session cookie is
# `__Host-lm_session` (Secure); over http://localhost it is `lm_session`.
# Production: https://localman.hoandat.com (https is required).
PUBLIC_URL=http://localhost:5173

LOG_LEVEL=info

# Proxies allowed to set X-Forwarded-For (per-IP rate limits): `false`, or
# IPs/CIDRs/loopback (a hop count outside production only; never `true`).
# Server .65 runs nginx on the same host: loopback. Behind another proxy,
# set its exact address.
TRUST_PROXY=loopback

# Sign-in through the shared IdP (repo hoandat-auth, docs/integration-guide.md).
# Local IdP from its docker compose (set its LOCALMAN_WEB_URL to PUBLIC_URL),
# production https://auth.hoandat.com.
OIDC_ISSUER=http://localhost:4500
OIDC_CLIENT_ID=localman-web
# Must equal LOCALMAN_WEB_CLIENT_SECRET of the IdP.
OIDC_CLIENT_SECRET=

# Encrypts the session tokens at rest (AES-256-GCM): `kid:base64key`, 32-byte
# keys. Rotate by prepending a new key and keeping the old one until the
# sessions it sealed expire: `k2:<new>,k1:<old>`.
# Generate: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# Web Push (optional; all three or none). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hoandat.com

# Localman's own Telegram bot (optional; from @BotFather, not the IdP's bot).
# Without a token the Telegram channel is off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Audit events pushed by the IdP to ${PUBLIC_URL}/internal/audit-events
# (optional; without both the endpoint answers 404). Must equal the IdP's
# AUDIT_CLIENT_ID / AUDIT_CLIENT_SECRET; set its AUDIT_EVENTS_URL to that URL.
AUDIT_CLIENT_ID=
AUDIT_CLIENT_SECRET=

# Mock runtime host: project URLs are https://{secret}.${MOCK_BASE_DOMAIN}{prefix}.
# Local dev: localhost:4100 (served over http), or localtest.me:4100 whose
# subdomains resolve to 127.0.0.1. Every host also serves /m/{secret}{prefix}.
MOCK_BASE_DOMAIN=localman.hoandat.com

# Mock runtime rate limits in requests per second: per project secret and per
# client IP (IPv6 grouped by /64; the IP comes through TRUST_PROXY). Over either
# limit the mock API answers 429 with Retry-After. Counted in process memory.
MOCK_RATE_LIMIT_PER_SECRET=60
MOCK_RATE_LIMIT_PER_IP=30
# Writes (POST/PUT/PATCH/DELETE) per second per secret: each one takes the
# project lock in a MongoDB transaction.
MOCK_WRITE_RATE_LIMIT_PER_SECRET=10
# Response bytes per second per secret (20 MiB); over it the mock API answers
# 429 with Retry-After until the next second. One response is at most 2 MB.
MOCK_RESPONSE_BYTES_PER_SECOND=20971520

# IdP `sub` of the Localman owners (admin pages), comma separated.
OWNER_SUBS=

# Owner's Telegram chat for alerts (Pro interest) sent by Localman's bot
# (needs TELEGRAM_BOT_TOKEN). Numeric chat id.
OWNER_TELEGRAM_CHAT_ID=

# Cloudflare Turnstile on public forms (both or none; required in production).
# Without them guests are not challenged (development only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
