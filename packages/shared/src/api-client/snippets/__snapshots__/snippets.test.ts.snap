"require 'net/http'
require 'uri'

uri = URI("https://api.example.com/users?notify=true")
request = Net::HTTP::Post.new(uri)
request.add_field("Authorization", "Bearer abc123")
request.add_field("Accept", "application/json")
request.add_field("X-Tag", "a")
request.add_field("X-Tag", "b")
