# Localman API on server .65: /opt/localman/.env (root:localman, mode 640).
# setup-server.sh seeds it from this file with a fresh SESSION_ENCRYPTION_KEY;
# fill in the empty secrets by hand (docs/deployment-guide.md). Read by pm2
# (infra/localman/ecosystem.config.cjs) and by the cleanup command through
# Node's --env-file. Validated at startup by apps/api/src/config/env.ts and
# feature-env.ts; an empty value counts as unset. Secrets never go in git
# (copies: the owner's iCloud "ENV production" folder). No SMTP: notifications
# go through Web Push and Telegram.

NODE_ENV=production
LOG_LEVEL=info

# One process, both servers. HOST is the interface both listen on: loopback
# only, so 4000/4100 are reachable through nginx and never directly.
HOST=127.0.0.1
DASHBOARD_PORT=4000
MOCK_PORT=4100

# mongod-localman (infra/localman/setup-mongo-localman.sh), app user `localman`:
# mongodb://localman:<app-password>@127.0.0.1:27018/localman?replicaSet=rs-localman&authSource=localman
MONGO_URI=

# Public origin of the dashboard (OIDC redirect URI, CSRF origin check,
# Turnstile hostname check) and the origin allowed by CORS.
PUBLIC_URL=https://localman.hoandat.com
WEB_ORIGIN=https://localman.hoandat.com

# nginx runs on the same host and forwards X-Forwarded-For $remote_addr.
TRUST_PROXY=127.0.0.1

# Sign-in through the IdP (repo hoandat-auth).
OIDC_ISSUER=https://auth.hoandat.com
OIDC_CLIENT_ID=localman-web
# Equals LOCALMAN_WEB_CLIENT_SECRET in /var/www/hoandat-auth/.env.
OIDC_CLIENT_SECRET=

# `kid:base64key` (32-byte keys); seeded by setup-server.sh. Rotate by
# prepending a new key: `k2:<new>,k1:<old>`.
SESSION_ENCRYPTION_KEY=

# Secret environment and global variables at rest, same format; seeded by
# setup-server.sh. Back it up with the database: without it secret values
# cannot be read. Rotate by prepending a new key and keeping every old one.
VARIABLE_ENCRYPTION_KEY=

# Web Push: all three or none. Keys: npx web-push generate-vapid-keys;
# subject e.g. mailto:admin@hoandat.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Localman's own bot (@localman_hoandat_bot from @BotFather, not the IdP's).
# It only sends messages; there is no webhook route. Empty token = channel off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=localman_hoandat_bot
# Owner chat for alerts (Pro interest, contact form): numeric chat id.
OWNER_TELEGRAM_CHAT_ID=

# IdP `sub` of the Localman owners (admin pages), comma separated.
OWNER_SUBS=

# Cloudflare Turnstile widget for localman.hoandat.com (required in production).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Audit events pushed by the IdP to /internal/audit-events (required:
# `email.reclaimed` removes an email the IdP gave to another account, and
# `method.unlinked` drops a Telegram chat). Both values must equal the IdP's
# AUDIT_CLIENT_ID / AUDIT_CLIENT_SECRET (secret at least 32 characters), and
# the IdP's AUDIT_EVENTS_URL must be
# https://localman.hoandat.com/internal/audit-events (nginx only lets the
# server itself call /internal/). Without both, the endpoint answers 404.
AUDIT_CLIENT_ID=
AUDIT_CLIENT_SECRET=

# Other domains claimed at the IdP (localman.<domain>, *.localman.<domain>),
# all four or none (unset: only localman.hoandat.com is served):
# - IDP_INTERNAL_URL: the IdP's internal API on loopback (http://127.0.0.1:4501);
# - IDP_INTERNAL_SECRET: Localman's `localman:<secret>` entry of the IdP's
#   INTERNAL_API_CREDENTIALS (at least 32 characters);
# - IDP_LOOPBACK_URL: the IdP's public listener on loopback
#   (http://127.0.0.1:4500): a tenant's token and userinfo endpoints are
#   called there with its Host, never through the domain's own DNS;
# - LOCALMAN_CLIENT_KEY: the key of localman-web from the IdP
#   (`node --env-file=.env dist/app-client-key.mjs localman-web <file>`).
IDP_INTERNAL_URL=
IDP_INTERNAL_SECRET=
IDP_LOOPBACK_URL=
LOCALMAN_CLIENT_KEY=

# Mock runtime: https://{secret}.localman.hoandat.com{prefix} and the
# fallback https://localman.hoandat.com/m/{secret}{prefix}.
MOCK_BASE_DOMAIN=localman.hoandat.com
# Requests per second per project secret / per client IP (IPv6 by /64),
# writes per second per secret, response bytes per second per secret.
MOCK_RATE_LIMIT_PER_SECRET=60
MOCK_RATE_LIMIT_PER_IP=30
MOCK_WRITE_RATE_LIMIT_PER_SECRET=10
MOCK_RESPONSE_BYTES_PER_SECOND=20971520

# API client: Tunelo domains (https://<name>.<domain>) allowed as tunnel
# mappings; the proxy may reach them on this server's own IP (Tunelo shares
# 103.72.98.65), Host forced to the tunnel host.
TUNNEL_DOMAINS=tunnel.hoandat.com,tunnel.inetdev.io.vn

# Public sharing (public links, guest links, collection access keys, Run
# buttons). Off: those operations are not routed and not offered over MCP.
# Turn on together with the web flag `publicSharing` in released-features;
# roll back by setting false and reloading the API.
PUBLIC_SHARING_ENABLED=false

# Comments and watch on collections. Off: those operations are not routed nor
# offered over MCP, and the watch digest job does not run. Turn on together
# with the web flag `comments` in released-features.
COMMENTS_ENABLED=false

# Forks, pull changes and merges. Off: those operations are not routed nor
# offered over MCP. Turn on together with the web flag `forks`.
FORKS_ENABLED=false

# Live Mock Sync: collections that follow a mock project. Off: those
# operations are not routed nor offered over MCP. Turn on together with the web
# flag `liveMockSync`.
LIVE_MOCK_SYNC_ENABLED=false

# Tunnels found through the user's Tunelo account and machines linked with
# `tunelo link`. Off: those operations are not routed. Turn on together with
# the web flag `tuneloAccounts`. Each tenant calls its own
# https://tunnel.<domain>; TUNELO_API_URL (one URL for all) is for dev only.
TUNELO_ACCOUNTS_ENABLED=false

# Native app sign-in (docs/decisions/0005-mobile-session-handoff.md). The
# association files /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json name these builds; bundle id and package come
# from brand.config.json. Both unset: the files answer 404 and the mobile
# sign-in is off. Apple Team ID (10 characters, public):
MOBILE_IOS_TEAM_ID=
# SHA-256 of the Android signing certificates (upload key and Play App
# Signing key), AA:BB:… comma separated:
MOBILE_ANDROID_CERT_SHA256=
