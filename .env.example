# Localman API (apps/api). Copy to .env for local development.
NODE_ENV=development

# Dashboard API (localman.hoandat.com) and public mock runtime ({secret}.localman.hoandat.com)
DASHBOARD_PORT=4000
MOCK_PORT=4100

# MongoDB single-node replica set from docker-compose.yml
MONGO_URI=mongodb://localhost:27017/localman?replicaSet=rs0&directConnection=true

# Origin allowed to call the dashboard API (Vite dev server)
WEB_ORIGIN=http://localhost:5173

LOG_LEVEL=info
