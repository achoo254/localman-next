TUNNEL_PORT=3001
# Tunnel domains, comma-separated. The first is the primary one used in every
# URL handed out; the others are still accepted while users move over.
# (TUNNEL_DOMAIN, single value, is still read when this is unset.)
TUNNEL_DOMAINS=tunnel.hoandat.com

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017/tunelo

# Accounts via the shared identity provider
# hybrid (default): account JWTs + anonymous tokens until LEGACY_TOKEN_CUTOFF.
# legacy: rollback switch, identity provider off, anonymous tokens as before.
AUTH_MODE=hybrid
AUTH_ISSUER=https://auth.hoandat.com
AUTH_AUDIENCE=https://tunnel.hoandat.com
# ISO date from which anonymous `tunelo_…` tokens stop opening tunnels.
# Empty = no cutoff yet.
LEGACY_TOKEN_CUTOFF=

# Auth
JWT_SECRET=change-me-to-a-random-secret
ADMIN_EMAILS=admin@example.com

# Web console at the apex host (sign-in + tunnel list). Optional: when the
# secret or the session key is missing the console stays off and the API and
# relay run as before.
# OAuth client registered at AUTH_ISSUER (confidential, client_secret_basic).
TUNELO_WEB_CLIENT_ID=tunelo-web
# Same value as TUNELO_WEB_CLIENT_SECRET in the identity provider's .env.
TUNELO_WEB_CLIENT_SECRET=
# Public origin of the console; default https://<first TUNNEL_DOMAINS entry>.
# The IdP registers <it>/auth/callback and <it>/ for this client.
TUNELO_WEB_PUBLIC_URL=https://tunnel.hoandat.com
# 32 random bytes, base64url (encrypts refresh tokens, keys CSRF tokens):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every console user out.
WEB_SESSION_KEY=
