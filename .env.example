# Localman API (apps/api). Copy to .env for local development.
NODE_ENV=development

# Dashboard API (localman.hoandat.com) and public mock runtime ({secret}.localman.hoandat.com)
DASHBOARD_PORT=4000
MOCK_PORT=4100
# Interface both servers listen on. Unset: every interface in development,
# 127.0.0.1 in production (only nginx on the same host reaches the ports).
HOST=

# MongoDB single-node replica set from docker-compose.yml
MONGO_URI=mongodb://localhost:27017/localman?replicaSet=rs0&directConnection=true

# Origin allowed to call the dashboard API (Vite dev server)
WEB_ORIGIN=http://localhost:5173

# Public origin of the dashboard: OIDC redirect URIs (${PUBLIC_URL}/auth/callback)
# and the CSRF origin check. Over https the session cookie is
# `__Host-lm_session` (Secure); over http://localhost it is `lm_session`.
# Production: https://localman.hoandat.com (https is required).
PUBLIC_URL=http://localhost:5173

LOG_LEVEL=info

# Proxies allowed to set X-Forwarded-For (per-IP rate limits): `false`, or
# IPs/CIDRs/loopback (a hop count outside production only; never `true`).
# Server .65 runs nginx on the same host: loopback. Behind another proxy,
# set its exact address.
TRUST_PROXY=loopback

# Sign-in through the shared IdP (repo hoandat-auth, docs/integration-guide.md).
# Local IdP from its docker compose (set its LOCALMAN_WEB_URL to PUBLIC_URL),
# production https://auth.hoandat.com.
OIDC_ISSUER=http://localhost:4500
OIDC_CLIENT_ID=localman-web
# Must equal LOCALMAN_WEB_CLIENT_SECRET of the IdP.
OIDC_CLIENT_SECRET=

# Encrypts the session tokens at rest (AES-256-GCM): `kid:base64key`, 32-byte
# keys. Rotate by prepending a new key and keeping the old one until the
# sessions it sealed expire: `k2:<new>,k1:<old>`.
# Generate: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# Encrypts secret environment and global variables at rest, same format.
# Optional: without it, saving a secret value answers 503. Rotate by
# prepending a new key and keeping every old one (values never expire).
VARIABLE_ENCRYPTION_KEY=

# Web Push (optional; all three or none). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hoandat.com

# Localman's own Telegram bot (optional; from @BotFather, not the IdP's bot).
# Without a token the Telegram channel is off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Audit events pushed by the IdP to ${PUBLIC_URL}/internal/audit-events
# (optional; without both the endpoint answers 404). Must equal the IdP's
# AUDIT_CLIENT_ID / AUDIT_CLIENT_SECRET; set its AUDIT_EVENTS_URL to that URL.
AUDIT_CLIENT_ID=
AUDIT_CLIENT_SECRET=

# Hosts served: PUBLIC_URL's host, MOCK_BASE_DOMAIN and its subdomains, the
# TUNNEL_DOMAINS (and subdomains), and loopback outside production. Any other
# Host header gets 421 (production also refuses loopback, except /healthz).

# Mock runtime host: project URLs are https://{secret}.${MOCK_BASE_DOMAIN}{prefix}.
# Local dev: localhost:4100 (served over http), or localtest.me:4100 whose
# subdomains resolve to 127.0.0.1. Every host also serves /m/{secret}{prefix}.
MOCK_BASE_DOMAIN=localman.hoandat.com

# Mock runtime rate limits in requests per second: per project secret and per
# client IP (IPv6 grouped by /64; the IP comes through TRUST_PROXY). Over either
# limit the mock API answers 429 with Retry-After. Counted in process memory.
MOCK_RATE_LIMIT_PER_SECRET=60
MOCK_RATE_LIMIT_PER_IP=30
# Writes (POST/PUT/PATCH/DELETE) per second per secret: each one takes the
# project lock in a MongoDB transaction.
MOCK_WRITE_RATE_LIMIT_PER_SECRET=10
# Response bytes per second per secret (20 MiB); over it the mock API answers
# 429 with Retry-After until the next second. One response is at most 2 MB.
MOCK_RESPONSE_BYTES_PER_SECOND=20971520

# API client proxy (POST /api/v1/proxy, MCP send_request): addresses it must
# never connect to, on top of the private, loopback, link-local, CGNAT, ULA,
# multicast and metadata ranges and every address of this machine's network
# interfaces, which it always refuses. Comma-separated IPs or CIDRs. Set the
# server's public IPs here when they are not on an interface (behind NAT);
# on .65 <SERVER_65_IP> is on the interface, listing it does no harm.
PROXY_BLOCKED_CIDRS=

# Tunelo domains, comma separated: a tunnel is https://<name>.<domain>. Only
# such URLs (https, no port/path/query) can be saved as tunnel mappings of the
# API client, and the proxy may reach them even on this server's own address
# (Tunelo may run on the same machine; Host is forced to the tunnel host).
# Empty: no tunnel mapping can be saved.
TUNNEL_DOMAINS=tunnel.hoandat.com

# IdP `sub` of the Localman owners (admin pages), comma separated.
OWNER_SUBS=

# Owner's Telegram chat for alerts (Pro interest) sent by Localman's bot
# (needs TELEGRAM_BOT_TOKEN). Numeric chat id.
OWNER_TELEGRAM_CHAT_ID=

# Cloudflare Turnstile on public forms (both or none; required in production).
# Without them guests are not challenged (development only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Public links, guest links, collection access keys and Run buttons. Off by
# default: their operations are not routed and not offered over MCP. Set true
# locally to work on them (the web needs VITE_FEATURES=publicSharing too).
PUBLIC_SHARING_ENABLED=false

# Comments and watch on collections. Off by default: their operations are not
# routed nor offered over MCP and the watch digest does not run. Set true
# locally to work on them (the web needs VITE_FEATURES=comments too).
COMMENTS_ENABLED=false

# Forks, pull changes and merges of collections and environments. Off by
# default: their operations are not routed nor offered over MCP. Set true
# locally to work on them (the web needs VITE_FEATURES=forks too).
FORKS_ENABLED=false

# Live Mock Sync: collections that follow a mock project. Off by default: its
# operations are not routed nor offered over MCP. Set true locally to work on
# it (the web needs VITE_FEATURES=liveMockSync too).
LIVE_MOCK_SYNC_ENABLED=false

# Public docs of mock projects. Off by default: their operations are not
# routed nor offered over MCP (the web needs VITE_FEATURES=projectDocs too).
PROJECT_DOCS_ENABLED=false

# Public Vietnamese fake data API (GET /api/v1/public/fake-data, no sign-in,
# 30 calls a minute per address, ADR-0010). Off by default: not routed nor
# offered over MCP. The web tool page needs VITE_FEATURES=vnFakeData; it
# generates in the browser and does not call this API.
PUBLIC_FAKE_DATA_ENABLED=false

# Tunnels found through the user's Tunelo account and machines linked with
# `tunelo link`. Off by default: their operations are not routed. Set true
# locally to work on them (the web needs VITE_FEATURES=tuneloAccounts too).
TUNELO_ACCOUNTS_ENABLED=false
# Tunelo API (e.g. a local tunelo-server on :3001). Unset:
# https://tunnel.hoandat.com.
# TUNELO_API_URL=http://localhost:3001

# Native app sign-in (optional; docs/decisions/0005-mobile-session-handoff.md).
# Apple Team ID and Android signing certificate SHA-256 fingerprints (AA:BB:…,
# comma separated). Both unset: no association files, mobile sign-in off.
MOBILE_IOS_TEAM_ID=
MOBILE_ANDROID_CERT_SHA256=
