TUNNEL_PORT=3001
# Tunnel domains, comma-separated. The first is the primary one used in every
# URL handed out; the others are still accepted while users move over.
# (TUNNEL_DOMAIN, single value, is still read when this is unset.)
TUNNEL_DOMAINS=tunnel.hoandat.com,tunnel.inetdev.io.vn

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017/tunelo

# Accounts via the shared identity provider
# hybrid (default): account JWTs + anonymous tokens until LEGACY_TOKEN_CUTOFF.
# legacy: rollback switch, identity provider off, anonymous tokens as before.
AUTH_MODE=hybrid
AUTH_ISSUER=https://auth.hoandat.com
AUTH_AUDIENCE=https://tunnel.hoandat.com
# ISO date from which anonymous `tunelo_…` tokens stop opening tunnels.
# Empty = no cutoff yet.
LEGACY_TOKEN_CUTOFF=

# Auth
JWT_SECRET=change-me-to-a-random-secret
ADMIN_EMAILS=admin@example.com
