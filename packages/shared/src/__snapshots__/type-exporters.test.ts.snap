exports[`exportZodSchemas > matches the snapshot 1`] = `
"// Generated by Localman from the project's resources.
import { z } from "zod";

export const userRecordSchema = z.object({
	id: z.string(),
	createdAt: z.string(),
	email: z.string(),
	age: z.number(),
	isActive: z.boolean(),
	joined: z.string(),
	"first-name": z.string(),
	profile: z.record(z.string(), z.unknown()),
	tags: z.array(z.unknown()),
	home: z.array(z.number()),
});
export type UserRecord = z.infer<typeof userRecordSchema>;

export const postRecordSchema = z.object({
	id: z.string(),
	userId: z.string(),
	title: z.string(),
	views: z.number(),
});
export type PostRecord = z.infer<typeof postRecordSchema>;

export const commentRecordSchema = z.object({
	id: z.string(),
	postId: z.string(),
	body: z.string(),
	likes: z.number(),
	author: z.object({
		name: z.string(),
		verified: z.boolean(),
		score: z.number(),
	}),
	labels: z.array(z.string()),
	mixed: z.array(z.union([z.number(), z.string(), z.null()])),
	empty: z.array(z.unknown()),
	unit: z.record(z.string(), z.unknown()),
	literal: z.string(),
});
export type CommentRecord = z.infer<typeof commentRecordSchema>;

export const resource2faCodeSchema = z.object({
	id: z.string(),
	valid: z.boolean(),
});
export type Resource2faCode = z.infer<typeof resource2faCodeSchema>;

export const user2RecordSchema = z.object({
	id: z.string(),
});
export type User2Record = z.infer<typeof user2RecordSchema>;

export const userSchema = userRecordSchema.extend({
	posts: z.array(postRecordSchema),
});
export type User = z.infer<typeof userSchema>;

export const postSchema = postRecordSchema.extend({
	author: userRecordSchema.nullable(),
	comments: z.array(commentRecordSchema),
});
export type Post = z.infer<typeof postSchema>;

export const commentSchema = commentRecordSchema.extend({
	post: postRecordSchema.nullable(),
});
export type Comment = z.infer<typeof commentSchema>;

export const user2Schema = user2RecordSchema.extend({
	lonely: z.null(),
});
export type User2 = z.infer<typeof user2Schema>;
"
`;
