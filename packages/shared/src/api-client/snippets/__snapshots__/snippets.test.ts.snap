exports[`go-native snippet > matches the golden output for a JSON POST 1`] = `
"package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	body := strings.NewReader("{\\n  \\"name\\": \\"Ann\\",\\n  \\"age\\": 30\\n}")
	req, err := http.NewRequest("POST", "https://api.example.com/users?notify=true", body)
	if err != nil {
		panic(err)
	}
	req.Header.Add("Authorization", "Bearer abc123")
	req.Header.Add("Accept", "application/json")
	req.Header.Add("X-Tag", "a")
	req.Header.Add("X-Tag", "b")
	req.Header.Add("Content-Type", "application/json")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(data))
}"
`;

